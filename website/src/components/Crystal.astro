---
// The Chiller crystal: six faceted shards around a cut core, lit by one light from the upper left. Every facet's
// shade comes from its normal against that light, so the shards read as one solid object, not one shape repeated.
const C = 200;
// Toward the light in screen space, turned into the artwork's space (the wrapper is rotated by -9deg).
const lightScreen = [-0.62, -0.78];
const unrotate = (9 * Math.PI) / 180;
const light = [
  lightScreen[0] * Math.cos(unrotate) - lightScreen[1] * Math.sin(unrotate),
  lightScreen[0] * Math.sin(unrotate) + lightScreen[1] * Math.cos(unrotate),
];
const ramp = ['#0a2a22', '#175a47', '#3c9c78', '#8fe2bf', '#dcfbec', '#ffffff'];
const hex = (h: string) => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));
const shade = (t: number) => {
  const x = Math.min(0.999, Math.max(0, t)) * (ramp.length - 1);
  const i = Math.floor(x), f = x - i;
  const [a, b] = [hex(ramp[i]), hex(ramp[i + 1])];
  return '#' + a.map((v, k) => Math.round(v + (b[k] - v) * f).toString(16).padStart(2, '0')).join('');
};
const turn = ([x, y]: number[], deg: number) => {
  const r = (deg * Math.PI) / 180;
  return [x * Math.cos(r) - y * Math.sin(r), x * Math.sin(r) + y * Math.cos(r)];
};
const lit = (normal: number[], deg: number, lift = 0) => {
  const [x, y] = turn(normal, deg);
  const length = Math.hypot(x, y);
  return 0.54 + 0.32 * ((x * light[0] + y * light[1]) / length) + lift;
};

// One shard, pointing up from the core: tip, cap ridge, shoulders, waist, base.
const P = { T: [200, 24], M: [200, 70], UL: [172, 60], UR: [228, 60], LL: [180, 142], LR: [220, 142], B: [200, 158] };
const pts = (...names: (keyof typeof P)[]) => names.map(n => P[n].join(' ')).join(' ');
const faces = [
  { key: 'capL', d: `M${pts('T', 'UL', 'M')}Z`, normal: [-0.55, -0.83], lift: 0.1 },
  { key: 'capR', d: `M${pts('T', 'UR', 'M')}Z`, normal: [0.55, -0.83], lift: 0.1 },
  { key: 'bodyL', d: `M${pts('UL', 'LL', 'B', 'M')}Z`, normal: [-1, -0.06], lift: 0 },
  { key: 'bodyR', d: `M${pts('UR', 'LR', 'B', 'M')}Z`, normal: [1, -0.06], lift: 0 },
];
const outline = `M${pts('T', 'UR', 'LR', 'B', 'LL', 'UL')}Z`;
const shards = [0, 60, 120, 180, 240, 300].map((angle, i) => {
  const faceShades = faces.map(f => ({ ...f, t: lit(f.normal, angle, f.lift) }));
  const left = faceShades[2].t, right = faceShades[3].t;
  return {
    angle, i,
    faces: faceShades.map(f => ({ ...f, id: `shard-${i}-${f.key}`, tip: shade(f.t + 0.1), base: shade(f.t - 0.16) })),
    rim: shade(Math.max(left, right) + 0.28),
    // The outer edge on the lit side catches the light.
    glint: left >= right ? `M${pts('UL', 'LL')}` : `M${pts('UR', 'LR')}`,
    brightness: Math.max(left, right),
  };
});

// The core: a pointy-top hexagon cut into six facets around a table.
const corner = (k: number, r: number) => [C + r * Math.cos(((-90 + 60 * k) * Math.PI) / 180), C + r * Math.sin(((-90 + 60 * k) * Math.PI) / 180)];
const coreFacets = [0, 1, 2, 3, 4, 5].map(k => {
  const mid = -60 + 60 * k;
  const normal = [Math.cos((mid * Math.PI) / 180), Math.sin((mid * Math.PI) / 180)];
  const t = 0.56 + 0.3 * (normal[0] * light[0] + normal[1] * light[1]);
  const [a, b, c, d] = [corner(k, 38), corner(k + 1, 38), corner(k + 1, 16), corner(k, 16)];
  return { d: `M${a.join(' ')} ${b.join(' ')} ${c.join(' ')} ${d.join(' ')}Z`, fill: shade(t) };
});
const table = `M${[0, 1, 2, 3, 4, 5].map(k => corner(k, 16).join(' ')).join(' ')}Z`;
const coreOutline = `M${[0, 1, 2, 3, 4, 5].map(k => corner(k, 38).join(' ')).join(' ')}Z`;

// Sparkles at the tips of the brightest shards; frost drifting around.
const tipOf = (angle: number, r = 176) => [C + r * Math.sin((angle * Math.PI) / 180), C - r * Math.cos((angle * Math.PI) / 180)];
const sparkles = [...shards].sort((a, b) => b.brightness - a.brightness).slice(0, 3).map((s, n) => ({ at: tipOf(s.angle), delay: 2.4 + n * 2.1, size: [9, 7, 6][n] }));
const frost = [[52, 120, 1.4], [74, 300, 1], [112, 46, 1.2], [318, 64, 1.6], [352, 182, 1], [338, 312, 1.3], [264, 362, 1.1], [138, 352, 1.5], [36, 214, 1], [366, 250, 0.9], [286, 28, 1], [94, 210, 0.8], [306, 140, 0.8], [176, 382, 1]];
---
<svg class="crystal-svg" viewBox="0 0 400 400" fill="none" aria-hidden="true">
  <defs>
    {shards.flatMap(s => s.faces.map(f => (
      <linearGradient id={f.id} x1="200" y1="24" x2="200" y2="158" gradientUnits="userSpaceOnUse">
        <stop stop-color={f.tip} /><stop offset="1" stop-color={f.base} />
      </linearGradient>
    )))}
    <radialGradient id="crystal-bloom" cx="200" cy="200" r="190" gradientUnits="userSpaceOnUse">
      <stop stop-color="#5fd6a5" stop-opacity=".34" /><stop offset=".45" stop-color="#3fae85" stop-opacity=".12" /><stop offset="1" stop-color="#3fae85" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="core-glow" cx="200" cy="200" r="70" gradientUnits="userSpaceOnUse">
      <stop stop-color="#d8ffee" stop-opacity=".26" /><stop offset="1" stop-color="#d8ffee" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="crystal-sweep-band" x1="0" y1="0" x2="1" y2="0">
      <stop stop-color="#fff" stop-opacity="0" /><stop offset=".5" stop-color="#fff" stop-opacity=".38" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="table-fill" x1="186" y1="186" x2="214" y2="214" gradientUnits="userSpaceOnUse">
      <stop stop-color="#f4fff9" /><stop offset="1" stop-color="#7fd5b0" />
    </linearGradient>
    <clipPath id="crystal-clip">
      {shards.map(s => <path transform={`rotate(${s.angle} 200 200)`} d={outline} />)}
      <path d={coreOutline} />
    </clipPath>
  </defs>

  <circle class="crystal-bloom" cx="200" cy="200" r="190" fill="url(#crystal-bloom)" />
  <g class="crystal-frost">
    {frost.map(([x, y, r], n) => <circle cx={x} cy={y} r={r} fill="#dffcef" fill-opacity={0.25 + (n % 4) * 0.12} style={`--frost-delay:${(n * 0.7) % 6}s`} />)}
  </g>

  <g class="crystal-float">
    {shards.map(s => (
      <g transform={`rotate(${s.angle} 200 200)`}>
        <g class="crystal-shard" style={`--shard-delay:${s.i * 75}ms`}>
          {s.faces.map(f => <path d={f.d} fill={`url(#${f.id})`} />)}
          {/* Inner refraction: faint lines inside the body facets. */}
          <path d="M190 82 186 136M210 82 214 136" stroke="#f2fff8" stroke-opacity=".14" stroke-width=".8" />
          {/* Ridges where facets meet, then the rim around the shard. */}
          <path d={`M${pts('UL', 'M', 'UR')}M${pts('T', 'M', 'B')}`} stroke="#f4fff9" stroke-opacity=".38" stroke-width=".8" stroke-linejoin="round" />
          <path d={outline} stroke={s.rim} stroke-opacity=".55" stroke-width="1" stroke-linejoin="round" />
          <path class="shard-glint" d={s.glint} stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" style={`--glint-delay:${2 + s.i * 0.35}s`} />
        </g>
      </g>
    ))}
    <g class="crystal-core">
      <circle cx="200" cy="200" r="70" fill="url(#core-glow)" />
      {coreFacets.map(f => <path d={f.d} fill={f.fill} stroke="#e8fff3" stroke-opacity=".35" stroke-width=".8" stroke-linejoin="round" />)}
      <path d={table} fill="url(#table-fill)" fill-opacity=".9" stroke="#ffffff" stroke-opacity=".6" stroke-width=".8" />
      <path d={coreOutline} stroke="#c9f7df" stroke-opacity=".8" stroke-width="1.2" stroke-linejoin="round" />
    </g>
    <g clip-path="url(#crystal-clip)">
      <g transform="rotate(24 200 200)"><rect class="crystal-sweep" x="-60" y="-40" width="70" height="480" fill="url(#crystal-sweep-band)" /></g>
    </g>
  </g>

  {sparkles.map(s => (
    <g transform={`translate(${s.at[0]} ${s.at[1]})`}>
      <path class="crystal-sparkle" style={`--sparkle-delay:${s.delay}s`} d={`M0 ${-s.size}C.8 -1.4 1.4 -.8 ${s.size} 0C1.4 .8 .8 1.4 0 ${s.size}C-.8 1.4 -1.4 .8 ${-s.size} 0C-1.4 -.8 -.8 -1.4 0 ${-s.size}Z`} fill="#ffffff" />
    </g>
  ))}
</svg>
